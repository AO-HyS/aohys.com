---
import PostHogAnalytics from "../components/PostHogAnalytics.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "@fontsource-variable/mona-sans/wdth.css";
import "@fontsource-variable/mona-sans/wdth-italic.css";
import "../styles/global.css";
import "../styles/horizonte.css";
import { bodyClass, ui } from "../styles/classes";
import type { ContentId, Locale, SeoStructuredData, SocialImageMetadata } from "@aohys/content-graph";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  canonicalUrl: string;
  alternates: Record<Locale | "x-default", string>;
  robots?: string;
  socialImage: SocialImageMetadata;
  structuredData?: SeoStructuredData;
  contentId?: ContentId | string;
}

const {
  title,
  description,
  locale,
  canonicalUrl,
  alternates,
  robots = "index,follow",
  socialImage,
  structuredData,
  contentId,
} = Astro.props;

const analyticsEnvironment = import.meta.env.AOHYS_ENV ?? "local";
const structuredDataJson = structuredData ? JSON.stringify(structuredData).replaceAll("<", "\\u003c") : null;
const analyticsPath = (() => {
  try {
    return new URL(canonicalUrl).pathname || "/";
  } catch {
    return "/";
  }
})();
---

<!doctype html>
<html lang={locale} class="overflow-x-clip scroll-smooth motion-reduce:scroll-auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta property="og:site_name" content="AOHYS" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage.url} />
    <meta property="og:image:secure_url" content={socialImage.url} />
    <meta property="og:image:alt" content={socialImage.alt} />
    <meta property="og:image:type" content={socialImage.type} />
    {socialImage.width && <meta property="og:image:width" content={String(socialImage.width)} />}
    {socialImage.height && <meta property="og:image:height" content={String(socialImage.height)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.url} />
    <meta name="twitter:image:alt" content={socialImage.alt} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="canonical" href={canonicalUrl} />
    {
      Object.entries(alternates).map(([hreflang, href]) => (
        <link rel="alternate" hreflang={hreflang} href={href} />
      ))
    }
    <title>{title}</title>
    {structuredDataJson && <script is:inline type="application/ld+json" set:html={structuredDataJson}></script>}
  </head>
  <body class={bodyClass}>
    <div class={ui.siteShell} data-site-shell="public" data-content-id={contentId}>
      <SiteHeader locale={locale} {...(contentId ? { currentId: contentId } : {})} />
      <main id="main-content">
        <slot />
      </main>
      <SiteFooter locale={locale} />
    </div>
    <PostHogAnalytics
      {...(contentId ? { contentId } : {})}
      locale={locale}
      canonicalUrl={canonicalUrl}
      path={analyticsPath}
      environment={analyticsEnvironment}
    />
  </body>
</html>
