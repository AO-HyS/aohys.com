---
import { fitStyle, type LensPhoto } from "./projects";

/* A living lens for interior pages: one photograph drifting under the glass, or several it cycles through. */
interface Props {
  photos: LensPhoto[];
  locale: "en" | "es";
  label?: string;
  class?: string;
}

const { photos, locale, label, class: className } = Astro.props;
const first = photos[0];
const images = photos.map((photo) => ({
  src: photo.texture,
  size: photo.size,
  focus: photo.focus,
  tint: photo.tint,
  alt: photo.alt[locale],
}));
const accessibleName = label ?? first?.alt[locale] ?? "";
---

<div
  class:list={["ma-lens", className]}
  role="img"
  aria-label={accessibleName}
  data-ma-lens
  data-gl="off"
  data-images={JSON.stringify(images)}
  style={first ? `--tint:${first.tint}` : undefined}
>
  <div class="ma-lens-dom">
    {first && (
      <div class="layer hz-fit" style={fitStyle(first)}>
        <img src={first.texture} alt="" decoding="async" />
      </div>
    )}
    <span class="shine" aria-hidden="true"></span>
  </div>
  <canvas data-gl aria-hidden="true"></canvas>
</div>
