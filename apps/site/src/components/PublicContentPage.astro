---
import {
  getArchitecturePageContent,
  getCaseStudyIndexContent,
  getCaseStudyPageContent,
  getLocalizedPath,
  getPracticePageContent,
  getPrivacyPageContent,
  getResumePageContent,
  type ContentId,
  type PublicRoute,
} from "@aohys/content-graph";
import { DASHBOARD_PUBLIC_SETTINGS } from "../generated/dashboard-public-settings";
import { getUiCopy } from "../i18n";
import HorizonteHome from "./horizonte/HorizonteHome.astro";
import { HORIZONTE_PASTELS, HORIZONTE_PROJECTS, fitStyle, getHorizonteProject } from "./horizonte/projects";
import { resolveProofMedia } from "./sunlit/proof-media";

interface Props { route: PublicRoute; }

const { route } = Astro.props;
const { id, locale, node, variant } = route;
const uiCopy = getUiCopy(locale);
const hz = uiCopy.horizonte;
const labels = uiCopy.sunlit.publicContent;
const contactCopy = uiCopy.contactForm;
const caseStudyIndexContent = getCaseStudyIndexContent(locale);
const architectureContent = id === "architecture" ? getArchitecturePageContent(locale) : undefined;
const practiceContent = id === "practice" ? getPracticePageContent(locale) : undefined;
const caseStudyContent = node.type === "case-study" ? getCaseStudyPageContent(id, locale) : undefined;
const resumeContent = node.type === "resume" ? getResumePageContent(locale) : undefined;
const privacyContent = node.type === "privacy" ? getPrivacyPageContent(locale) : undefined;
const isHome = id === "home";
const isPractice = id === "practice";
const isArchitecture = id === "architecture";
const isWorkIndex = node.type === "case-study-index";
const isCaseStudy = node.type === "case-study";
const isResume = node.type === "resume";
const isContact = node.type === "contact";
const isPrivacy = node.type === "privacy";
const contactEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? "";
const publicContactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL ?? "alejandro.ortiz@aohys.com";
const publicWhatsAppUrl = DASHBOARD_PUBLIC_SETTINGS.PUBLIC_WHATSAPP_URL ?? import.meta.env.PUBLIC_WHATSAPP_URL ?? "https://wa.me/522299020825";
const directEmailHref = `mailto:${publicContactEmail}`;
const contactHref = getLocalizedPath("contact", locale);
const workHref = getLocalizedPath("case-studies", locale);

const PASTEL_CYCLE = [HORIZONTE_PASTELS.honey, HORIZONTE_PASTELS.apricot, HORIZONTE_PASTELS.olive];
const pastel = (index: number) => PASTEL_CYCLE[index % PASTEL_CYCLE.length];

function localizedHref(contentId?: ContentId) {
  return contentId ? getLocalizedPath(contentId, locale) : undefined;
}
const routeActions = [
  { label: variant.primaryActionLabel, href: localizedHref(variant.primaryActionContentId), contentId: variant.primaryActionContentId },
  { label: variant.secondaryActionLabel, href: localizedHref(variant.secondaryActionContentId), contentId: variant.secondaryActionContentId },
].filter((action): action is { label: string; href: string; contentId: ContentId } => Boolean(action.label && action.href && action.contentId));
const secondaryRouteActions = routeActions.filter((action) => action.contentId !== "contact");

/* Case study */
const caseProject = isCaseStudy ? getHorizonteProject(String(id)) : undefined;
const caseMedia = isCaseStudy && caseStudyContent
  ? resolveProofMedia(String(id), caseStudyContent.publicEvidence[0]?.src, caseStudyContent.publicEvidence[0]?.altText, caseStudyContent.publicEvidence[0]?.kind, true)
  : undefined;
const caseLiveLinks = caseStudyContent?.publicEvidence.filter((evidence) => evidence.href && evidence.href !== route.path) ?? [];
const caseOrder = caseStudyIndexContent.entries;
const caseIndex = caseOrder.findIndex((entry) => entry.contentId === id);
const nextCase = caseIndex >= 0 ? caseOrder[(caseIndex + 1) % caseOrder.length] : undefined;
const nextProject = nextCase ? getHorizonteProject(String(nextCase.contentId)) : undefined;
const nextMedia = nextCase ? resolveProofMedia(String(nextCase.contentId)) : undefined;
/* Diagrams and maps are shown whole inside an orb; photographs and screens fill it. */
const DIAGRAM_KINDS = new Set(["diagram", "architecture-note", "private-system"]);
const orbImageClass = (kind?: string) => (kind && DIAGRAM_KINDS.has(kind) ? "contain" : "cover");
const isEnterpriseCase = id === "case-study:enterprise-systems";

/* Resume */
const founderJob = resumeContent?.experience.find((job) => job.company === "AOHYS");
---

{isHome ? (
  <HorizonteHome locale={locale} contentId={String(id)} />
) : (
  <div class="ma" data-ma data-page={isResume ? "resume" : isContact ? "contact" : isPractice ? "practice" : node.type}>
    <svg class="ma-line" aria-hidden="true" focusable="false"></svg>

    {isCaseStudy && caseStudyContent && caseMedia ? (
      <article data-case-study-content-id={id} style={caseProject ? `--tint:${caseProject.tint}` : undefined}>
        <header class="ma-hero ma-grid">
          <div class="ma-hero-text" data-ma-block>
            <a class="ma-back" href={workHref} data-ma-node="before"><span aria-hidden="true">←</span> {hz.back}</a>
            <p class="ma-kicker">{caseStudyContent.statusLabel}</p>
            <h1>{variant.title}</h1>
            <p class="ma-lede">{caseStudyContent.overview}</p>
            {caseLiveLinks.length > 0 && (
              <nav class="ma-actions" aria-label={hz.caseLinks}>
                {caseLiveLinks.map((evidence) => (
                  <a class="hz-link" href={evidence.href} rel="noopener" target="_blank" aria-label={evidence.altText}>{evidence.label} <span aria-hidden="true">↗</span></a>
                ))}
              </nav>
            )}
          </div>
          <figure class={caseProject ? "ma-hero-orb hz-fit" : "ma-hero-orb"} style={caseProject ? fitStyle(caseProject) : undefined}>
            {caseProject
              ? <img src={caseProject.texture} alt={caseProject.alt[locale]} fetchpriority="high" />
              : <img class={orbImageClass(caseMedia.kind)} src={caseMedia.src} alt={caseMedia.alt} fetchpriority="high" />}
          </figure>
          <a class="ma-cue" href="#case-need">{hz.scrollCue}</a>
        </header>

        <section class="ma-section ma-grid" id="case-need" aria-labelledby="case-need-title">
          <div class="ma-block pos-left" data-ma-block>
            <h2 id="case-need-title" class="ma-kicker" data-ma-node="before" data-ma-color={pastel(0)}>{labels.businessNeed}</h2>
            <p class="ma-statement">{caseStudyContent.problem.body}</p>
          </div>
        </section>

        <section class="ma-section ma-grid" aria-labelledby="case-built-title">
          <div class="ma-block pos-right" data-ma-block>
            <h2 id="case-built-title" data-ma-node="before" data-ma-color={pastel(1)}>{caseStudyContent.businessOutcome.title}</h2>
            <p>{caseStudyContent.businessOutcome.body}</p>
            <div class="ma-pairs">
              <div><h3>{caseStudyContent.role.title}</h3><p>{caseStudyContent.role.body}</p></div>
            </div>
          </div>
        </section>

        <section class="ma-section ma-grid" aria-labelledby="case-decisions-title">
          <div class="ma-block pos-left" data-ma-block>
            <h2 id="case-decisions-title" data-ma-node="before" data-ma-color={pastel(2)}>{caseStudyContent.architectureDecisions.title}</h2>
            <div class="ma-pairs">
              <div><h3>{labels.considerations}</h3><p>{caseStudyContent.constraints.body}</p></div>
              <div><h3>{caseStudyContent.architectureDecisions.title}</h3><p>{caseStudyContent.architectureDecisions.body}</p></div>
            </div>
          </div>
        </section>

        <section class="ma-section ma-grid" aria-labelledby="case-interface-title">
          <div class="ma-block pos-wide" data-ma-block>
            <h2 id="case-interface-title" data-ma-node="before" data-ma-color={pastel(0)}>{caseStudyContent.publicEvidenceTitle}</h2>
            <figure class="ma-frame">
              <img src={caseMedia.src} alt={caseMedia.alt} loading="lazy" decoding="async" />
              {caseStudyContent.publicEvidence[0]?.description && <figcaption>{caseStudyContent.publicEvidence[0].description}</figcaption>}
            </figure>
          </div>
        </section>

        <section class="ma-section ma-grid" aria-labelledby="case-delivery-title">
          <div class="ma-block pos-right" data-ma-block>
            <h2 id="case-delivery-title" data-ma-node="before" data-ma-color={pastel(1)}>{caseStudyContent.executionHighlights.title}</h2>
            <p>{caseStudyContent.executionHighlights.body}</p>
            <div class="ma-pairs">
              <div><h3>{caseStudyContent.qualitySecurityPerformance.title}</h3><p>{caseStudyContent.qualitySecurityPerformance.body}</p></div>
              {isEnterpriseCase && <div><h3>{caseStudyContent.confidentialityNote.title}</h3><p>{caseStudyContent.confidentialityNote.body}</p></div>}
            </div>
          </div>
        </section>

        {nextCase && (
          <section class="ma-section ma-grid" aria-labelledby="case-next-title">
            <div class="ma-block pos-left" data-ma-block>
              <h2 id="case-next-title" class="ma-kicker" data-ma-node="before" data-ma-color={pastel(2)}>{hz.next}</h2>
              <a class="ma-next" href={nextCase.path} data-vt-from="#ma-next-orb">
                {nextProject
                  ? <span class="hz-orb hz-fit" id="ma-next-orb" style={`--tint:${nextProject.tint};${fitStyle(nextProject)}`}><img src={nextProject.texture} alt="" loading="lazy" decoding="async" /></span>
                  : <span class="hz-orb" id="ma-next-orb" style={`--tint:${HORIZONTE_PASTELS.honey}`}>{nextMedia && <img class={orbImageClass(nextMedia.kind)} src={nextMedia.src} alt="" loading="lazy" decoding="async" />}</span>}
                <span><span class="n-name">{nextCase.title}</span><span class="n-purpose">{nextCase.statusLabel}</span></span>
              </a>
            </div>
          </section>
        )}
      </article>
    ) : isWorkIndex ? (
      <>
        <section class="ma-hero ma-grid solo" aria-labelledby="work-title" data-case-study-index-content-id={id}>
          <div class="ma-hero-text" data-ma-block>
            <p class="ma-kicker" data-ma-node="before">{labels.workArchive}</p>
            <h1 id="work-title">{caseStudyIndexContent.heading}</h1>
            <p class="ma-lede">{caseStudyIndexContent.intro}</p>
          </div>
        </section>
        <section class="ma-section ma-grid" aria-label={labels.workArchive}>
          <div class="ma-block pos-wide" data-ma-block>
            <ol class="hz-work" data-ma-node="above" data-ma-color={pastel(0)}>
              {caseStudyIndexContent.entries.map((entry) => {
                const project = getHorizonteProject(String(entry.contentId));
                const media = resolveProofMedia(String(entry.contentId));
                const slug = String(entry.contentId).replace("case-study:", "");
                return (
                  <li class="hz-work-row" data-content-id={entry.contentId}>
                    <div class="w-left">
                      <h2 class="ma-index-title">{entry.title}</h2>
                      <span class="hz-meta">{entry.statusLabel}</span>
                    </div>
                    <div class="w-axis">
                      {project
                        ? <span class="hz-orb hz-fit" id={`hz-orb-${slug}`} style={`--tint:${project.tint};${fitStyle(project)}`}><img src={project.texture} alt="" loading="lazy" decoding="async" /></span>
                        : <span class="hz-orb" id={`hz-orb-${slug}`} style={`--tint:${HORIZONTE_PASTELS.olive}`}><img class={orbImageClass(media.kind)} src={media.src} alt="" loading="lazy" decoding="async" /></span>}
                    </div>
                    <div class="w-right">
                      <p class="contrib">{entry.summary}</p>
                      <div class="links"><a class="hz-link" href={entry.path} data-vt-from={`#hz-orb-${slug}`}>{hz.readCase} <span aria-hidden="true">→</span></a></div>
                    </div>
                  </li>
                );
              })}
            </ol>
          </div>
        </section>
      </>
    ) : isPractice && practiceContent ? (
      <>
        <section class="ma-hero ma-grid solo" aria-labelledby="practice-title" data-practice-content-id={id}>
          <div class="ma-hero-text" data-ma-block>
            <p class="ma-kicker" data-ma-node="before">{labels.practice}</p>
            <h1 id="practice-title">{practiceContent.heading}</h1>
            <p class="ma-lede">{practiceContent.deck}</p>
            <div class="ma-actions">
              <a class="hz-btn" href={contactHref}>{labels.talk} <span class="arrow" aria-hidden="true">→</span></a>
              {secondaryRouteActions.map((action) => <a class="hz-link" href={action.href}>{action.label} <span aria-hidden="true">→</span></a>)}
            </div>
          </div>
        </section>
        {practiceContent.services.map((service, index) => (
          <section class="ma-section ma-grid" id={service.id} aria-labelledby={`${service.id}-title`}>
            <div class={`ma-block ${index % 2 === 0 ? "pos-right" : "pos-left"}`} data-ma-block>
              <h2 id={`${service.id}-title`} data-ma-node="before" data-ma-color={pastel(index)}>{service.title}</h2>
              <div class="ma-pairs">
                <div><h3>{labels.serviceFit}</h3><p>{service.problem}</p></div>
                <div><h3>{labels.serviceResult}</h3><p>{service.result}</p></div>
                <div><h3>{labels.serviceCollaboration}</h3><p>{service.engagement}</p></div>
              </div>
              <ul class="ma-tags" aria-label={labels.serviceOutputs}>{service.deliverables.map((deliverable) => <li>{deliverable}</li>)}</ul>
            </div>
          </section>
        ))}
        <section class="ma-section ma-grid" aria-labelledby="practice-process-title">
          <div class="ma-block pos-right" data-ma-block>
            <h2 id="practice-process-title" data-ma-node="before" data-ma-color={pastel(1)}>{practiceContent.processHeading}</h2>
            <ol class="ma-list">{practiceContent.process.map((step) => <li><div><h3>{step.label}</h3><p>{step.text}</p></div></li>)}</ol>
          </div>
        </section>
        <section class="ma-section ma-grid" aria-labelledby="practice-deliverables-title">
          <div class="ma-block pos-left" data-ma-block>
            <h2 id="practice-deliverables-title" data-ma-node="before" data-ma-color={pastel(2)}>{practiceContent.deliverablesHeading}</h2>
            <ul class="ma-tags">{practiceContent.deliverables.map((deliverable) => <li>{deliverable}</li>)}</ul>
            <nav class="ma-links" aria-label={practiceContent.relatedHeading}>
              {practiceContent.relatedContentIds.map((contentId) => (
                <a class="hz-link" href={getLocalizedPath(contentId, locale)}>{contentId === "architecture" ? labels.architecture : labels.work} <span aria-hidden="true">→</span></a>
              ))}
            </nav>
          </div>
        </section>
      </>
    ) : isArchitecture && architectureContent ? (
      <>
        <section class="ma-hero ma-grid" aria-labelledby="architecture-title" data-architecture-content-id={id} style={`--tint:${HORIZONTE_PROJECTS.find((p) => p.contentId === "architecture")?.tint ?? HORIZONTE_PASTELS.honey}`}>
          <div class="ma-hero-text" data-ma-block>
            <p class="ma-kicker" data-ma-node="before">{labels.architecture}</p>
            <h1 id="architecture-title">{architectureContent.heading}</h1>
            <p class="ma-lede">{architectureContent.deck}</p>
            <div class="ma-actions">
              <a class="hz-link" href={getLocalizedPath("case-study:engineering-practice", locale)}>{hz.buildAgents} <span aria-hidden="true">→</span></a>
              {secondaryRouteActions.filter((action) => action.contentId !== "architecture").map((action) => <a class="hz-link" href={action.href}>{action.label} <span aria-hidden="true">→</span></a>)}
            </div>
          </div>
          {(() => {
            const project = getHorizonteProject("architecture");
            return project ? (
              <figure class="ma-hero-orb hz-fit" style={fitStyle(project)}><img src={project.texture} alt={project.alt[locale]} fetchpriority="high" /></figure>
            ) : null;
          })()}
          <a class="ma-cue" href="#architecture-system">{hz.scrollCue}</a>
        </section>

        <section class="ma-section ma-grid" id="architecture-system" aria-labelledby="system-map-title">
          <div class="ma-block pos-right" data-ma-block>
            <h2 id="system-map-title" data-ma-node="before" data-ma-color={pastel(0)}>{architectureContent.systemHeading}</h2>
            <p>{architectureContent.systemBody}</p>
            <ol class="ma-list">
              {architectureContent.layers.map((layer) => (
                <li data-layer={layer.id}><div><h3>{layer.label}</h3><p>{layer.body}</p><ul class="ma-tags">{layer.technologies.map((technology) => <li>{technology}</li>)}</ul></div></li>
              ))}
            </ol>
          </div>
        </section>

        <section class="ma-section ma-grid" aria-labelledby="tradeoffs-title">
          <div class="ma-block pos-left" data-ma-block>
            <h2 id="tradeoffs-title" data-ma-node="before" data-ma-color={pastel(1)}>{architectureContent.tradeoffsHeading}</h2>
            <div class="ma-pairs">
              {architectureContent.tradeoffs.map((tradeoff) => (
                <div><h3>{tradeoff.title}</h3><p>{tradeoff.reason}</p><p class="ma-muted">{tradeoff.result}</p></div>
              ))}
            </div>
          </div>
        </section>

        <section class="ma-section ma-grid" aria-labelledby="architecture-notes-title">
          <div class="ma-block pos-right" data-ma-block>
            <h2 id="architecture-notes-title" data-ma-node="before" data-ma-color={pastel(2)}>{labels.architectureNotes}</h2>
            <p class="ma-muted">{labels.architectureNotesIntro}</p>
            <ol class="ma-list">
              {architectureContent.sections.map((section) => (
                <li><div><h3>{section.title}</h3><p>{section.body}</p>{section.links && <div class="ma-links">{section.links.map((link) => <a class="hz-link" href={link.href}>{link.label} <span aria-hidden="true">↗</span></a>)}</div>}</div></li>
              ))}
            </ol>
          </div>
        </section>

        <section class="ma-section ma-grid" aria-labelledby="architecture-sources-title">
          <div class="ma-block pos-left" data-ma-block>
            <h2 id="architecture-sources-title" class="ma-kicker" data-ma-node="before" data-ma-color={pastel(0)}>{architectureContent.sourceLabel}</h2>
            <div class="ma-links">{architectureContent.sourceLinks.map((link) => <a class="hz-link" href={link.href}>{link.label} <span aria-hidden="true">↗</span></a>)}</div>
            <p class="ma-muted">{architectureContent.boundaryNote}</p>
          </div>
        </section>
      </>
    ) : isResume && resumeContent ? (
      <>
        <section class="ma-hero ma-grid solo" aria-labelledby="about-title" data-resume-content-id={id}>
          <div class="ma-hero-text" data-ma-block>
            <p class="ma-kicker" data-ma-node="before">{resumeContent.role} · {resumeContent.location}</p>
            <h1 id="about-title">{resumeContent.name}</h1>
            <p class="ma-lede">{resumeContent.intro}</p>
            <div class="ma-actions">
              <a class="hz-btn" href={resumeContent.pdf.href}>{hz.download} <span class="arrow" aria-hidden="true">↓</span></a>
              <a class="hz-link" href={contactHref}>{labels.talk} <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </section>

        <section class="ma-section ma-grid" aria-labelledby="profile-title">
          <div class="ma-block pos-right" data-ma-block>
            <h2 id="profile-title" data-ma-node="before" data-ma-color={pastel(0)}>{resumeContent.summaryTitle}</h2>
            {resumeContent.summary.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </section>

        <section class="ma-section ma-grid" aria-labelledby="highlights-title">
          <div class="ma-block pos-left" data-ma-block>
            <h2 id="highlights-title" data-ma-node="before" data-ma-color={pastel(1)}>{resumeContent.highlightsTitle}</h2>
            <ol class="ma-list">{resumeContent.highlights.map((highlight) => <li><div><h3>{highlight.label}</h3><p>{highlight.text}</p></div></li>)}</ol>
          </div>
        </section>

        <section class="ma-grid" aria-labelledby="experience-title">
          <div class="ma-block pos-center" data-ma-block style="text-align:center;justify-items:center">
            <h2 id="experience-title" data-ma-node="above" data-ma-color={pastel(2)}>{resumeContent.experienceTitle}</h2>
          </div>
        </section>
        <ol class="ma-timeline">
          {resumeContent.experience.map((job, index) => (
            <li class="ma-tl">
              <span class="anchor" data-ma-node data-ma-color={job === founderJob ? HORIZONTE_PASTELS.honey : pastel(index)}></span>
              <div class="card">
                <span class="hz-num">{job.period.replace(" - ", " – ")}</span>
                <h3>{job.company}</h3>
                <span class="ti">{job.role}</span>
                <ul>{job.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
              </div>
            </li>
          ))}
        </ol>

        <section class="ma-section ma-grid" aria-labelledby="projects-title">
          <div class="ma-block pos-right" data-ma-block>
            <h2 id="projects-title" data-ma-node="before" data-ma-color={pastel(0)}>{resumeContent.projectsTitle}</h2>
            <div class="ma-pairs">
              {resumeContent.projects.map((project) => (
                <div><h3>{project.title}</h3><p>{project.summary}</p><ul class="ma-bullets">{project.bullets.map((bullet) => <li>{bullet}</li>)}</ul></div>
              ))}
            </div>
          </div>
        </section>

        <section class="ma-section ma-grid" aria-labelledby="capabilities-title">
          <div class="ma-block pos-left" data-ma-block>
            <h2 id="capabilities-title" data-ma-node="before" data-ma-color={pastel(1)}>{resumeContent.skillsTitle}</h2>
            <div class="ma-pairs">
              {resumeContent.skills.map((group) => <div><h3>{group.label}</h3><ul class="ma-tags">{group.items.map((item) => <li>{item}</li>)}</ul></div>)}
            </div>
          </div>
        </section>

        <section class="ma-section ma-grid" aria-labelledby="education-title">
          <div class="ma-block pos-right" data-ma-block>
            <h2 id="education-title" data-ma-node="before" data-ma-color={pastel(2)}>{resumeContent.educationTitle}</h2>
            {resumeContent.education.map((item) => <p><strong>{item.degree}</strong><br /><span class="ma-muted">{item.institution} · {item.period}</span></p>)}
            <p>{resumeContent.languagesTitle}: {resumeContent.languages.join(" · ")}</p>
            <div class="ma-links">
              {resumeContent.contactLinks.map((link) => <a class="hz-link" href={link.href}>{link.label} <span aria-hidden="true">↗</span></a>)}
            </div>
          </div>
        </section>
      </>
    ) : isContact ? (
      <>
        <section class="ma-hero ma-grid solo" aria-labelledby="contact-title" data-contact-content-id={id}>
          <div class="ma-hero-text" data-ma-block>
            <p class="ma-kicker" data-ma-node="before">{labels.contactRail}</p>
            <h1 id="contact-title">{variant.title}</h1>
            <p class="ma-lede">{variant.summary}</p>
            <div class="ma-actions">
              <a class="hz-link" href={publicWhatsAppUrl} data-analytics-event="whatsapp_cta_clicked" data-analytics-target="contact_direct_panel">{contactCopy.whatsappLabel} <span aria-hidden="true">↗</span></a>
              <a class="hz-link" href={directEmailHref} data-analytics-event="email_cta_clicked" data-analytics-target="contact_direct_panel">{publicContactEmail} <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </section>

        <section class="ma-section ma-grid" aria-label={contactCopy.formTitle}>
          <div class="ma-block pos-aside" data-ma-block>
            <h2 data-ma-node="before" data-ma-color={pastel(1)}>{contactCopy.formTitle}</h2>
            <p>{contactCopy.formIntro}</p>
            <div class="ma-pairs">
              <div>
                <h3>{labels.contactBriefTitle}</h3>
                <ol class="ma-list">{labels.contactBriefPrompts.map(([term, description]) => <li><div><strong>{term}</strong><span class="ma-muted">{description}</span></div></li>)}</ol>
              </div>
            </div>
          </div>
          <form
            class="ma-form pos-form"
            method="post"
            action={contactEndpoint || directEmailHref}
            data-contact-form
            data-contact-endpoint={contactEndpoint}
            data-success-message={contactCopy.successMessage}
            data-degraded-success-message={contactCopy.degradedSuccessMessage}
            data-error-message={contactCopy.errorMessage}
            data-validation-message={contactCopy.validationMessage}
            data-rate-limited-message={contactCopy.rateLimitedMessage}
            data-email-error-message={contactCopy.emailErrorMessage}
            data-backend-error-message={contactCopy.backendErrorMessage}
            data-endpoint-missing={contactCopy.endpointMissing}
            data-retry-label={contactCopy.retryLabel}
            data-analytics-view="contact_form_viewed"
            data-analytics-submit="contact_form_submit_attempted"
            data-analytics-target="contact_form"
          >
            <label><span>{contactCopy.nameLabel}</span><input name="name" type="text" autocomplete="name" required /></label>
            <div class="grid-2">
              <label><span>{contactCopy.emailLabel}</span><input name="email" type="email" autocomplete="email" required aria-required="true" /></label>
              <label><span>{contactCopy.phoneLabel}<small id="contact-phone-requirement" data-phone-requirement data-optional-label={contactCopy.phoneOptionalHint} data-required-label={contactCopy.phoneRequiredHint}>{contactCopy.phoneOptionalHint}</small></span><input name="phone" type="tel" autocomplete="tel" data-contact-phone aria-required="false" aria-describedby="contact-phone-requirement contact-path-help" /></label>
            </div>
            <label><span>{contactCopy.companyLabel}</span><input name="company" type="text" autocomplete="organization" /></label>
            <label><span>{contactCopy.intentLabel}</span><select name="intent" required><option value="project">{contactCopy.intentProject}</option><option value="hiring">{contactCopy.intentHiring}</option><option value="architecture-review">{contactCopy.intentArchitecture}</option><option value="website">{contactCopy.intentWebsite}</option><option value="other">{contactCopy.intentOther}</option></select></label>
            <fieldset aria-describedby="contact-path-help">
              <legend>{contactCopy.preferredContactLabel}</legend>
              <div class="radios">
                <label><input name="preferredContactPath" type="radio" value="email" required checked /><span>{contactCopy.preferredEmail}</span></label>
                <label><input name="preferredContactPath" type="radio" value="whatsapp" required /><span>{contactCopy.preferredWhatsApp}</span></label>
              </div>
              <p id="contact-path-help">{contactCopy.preferredContactHelp}</p>
            </fieldset>
            <label><span>{contactCopy.messageLabel}</span><textarea name="message" rows="6" placeholder={contactCopy.messagePlaceholder} required></textarea></label>
            <label class="consent"><input name="consentToContact" type="checkbox" value="true" required /><span>{contactCopy.consentLabel}</span></label>
            <label class="honeypot" aria-hidden="true"><span>{contactCopy.honeypotLabel}</span><input name="website" type="text" autocomplete="off" tabindex="-1" /></label>
            <input name="formStartedAt" type="hidden" value="" />
            <input name="sourcePath" type="hidden" value={route.path} />
            <input name="locale" type="hidden" value={locale} />
            <input name="referrer" type="hidden" value="" />
            <div class="submit"><button class="hz-btn" type="submit" data-submit-label={contactCopy.submitLabel} data-sending-label={contactCopy.sendingLabel}>{contactCopy.submitLabel}</button><p>{contactCopy.fallbackText} <a href={publicWhatsAppUrl} data-analytics-event="whatsapp_cta_clicked" data-analytics-target="contact_form_error_fallback">{contactCopy.whatsappLabel}</a></p></div>
            <p class="ma-status" role="status" data-contact-status></p>
          </form>
        </section>

        <script>
          const dispatchContactAnalytics = (event: string, properties: Record<string, string | boolean> = {}) => {
            window.dispatchEvent(new CustomEvent("aohys:analytics", { detail: { event, properties } }));
          };
          const messageWithRetry = (message: string | undefined, retry: string | undefined) => [message, retry].filter(Boolean).join(" ");
          const readJson = async (response: Response): Promise<Record<string, unknown>> => {
            try {
              const value: unknown = await response.json();
              return typeof value === "object" && value !== null && !Array.isArray(value)
                ? value as Record<string, unknown>
                : {};
            } catch { return {}; }
          };
          const stringStatus = (payload: unknown, key: string, fallback: string) => {
            if (!payload || typeof payload !== "object") return fallback;
            const value = (payload as Record<string, unknown>)[key];
            return typeof value === "string" && value ? value : fallback;
          };
          for (const candidate of document.querySelectorAll("[data-contact-form]")) {
            if (!(candidate instanceof HTMLFormElement)) continue;
            const form = candidate;
            const status = form.querySelector("[data-contact-status]");
            const startedAt = form.querySelector('input[name="formStartedAt"]');
            const referrer = form.querySelector('input[name="referrer"]');
            const submitButton = form.querySelector('button[type="submit"]');
            const phoneInput = form.querySelector("[data-contact-phone]");
            const phoneRequirement = form.querySelector("[data-phone-requirement]");
            const preferredContactOptions = Array.from(form.querySelectorAll('input[name="preferredContactPath"]')).filter((input): input is HTMLInputElement => input instanceof HTMLInputElement);
            const syncPreferredContactRequirements = () => {
              const whatsappSelected = preferredContactOptions.some((input) => input.checked && input.value === "whatsapp");
              if (phoneInput instanceof HTMLInputElement) {
                phoneInput.required = whatsappSelected;
                phoneInput.setAttribute("aria-required", String(whatsappSelected));
              }
              if (phoneRequirement instanceof HTMLElement) {
                phoneRequirement.textContent = whatsappSelected ? phoneRequirement.dataset.requiredLabel ?? "" : phoneRequirement.dataset.optionalLabel ?? "";
              }
            };
            preferredContactOptions.forEach((input) => input.addEventListener("change", syncPreferredContactRequirements));
            syncPreferredContactRequirements();
            if (startedAt instanceof HTMLInputElement) startedAt.value = String(Date.now());
            if (referrer instanceof HTMLInputElement) referrer.value = document.referrer;
            form.addEventListener("submit", async (event) => {
              event.preventDefault();
              if (!form.checkValidity()) {
                if (status instanceof HTMLElement) { status.dataset.state = "error"; status.textContent = messageWithRetry(form.dataset.validationMessage, form.dataset.retryLabel); }
                dispatchContactAnalytics("contact_form_submit_failed", { failure_reason: "validation_failed" });
                form.reportValidity(); return;
              }
              const endpoint = form.dataset.contactEndpoint ?? "";
              if (!endpoint) {
                if (status instanceof HTMLElement) { status.dataset.state = "error"; status.textContent = messageWithRetry(form.dataset.endpointMissing, form.dataset.retryLabel); }
                dispatchContactAnalytics("contact_form_submit_failed", { failure_reason: "endpoint_missing" }); return;
              }
              const formData = new FormData(form);
              const payload = Object.fromEntries(formData.entries());
              if (submitButton instanceof HTMLButtonElement) { submitButton.disabled = true; submitButton.textContent = submitButton.dataset.sendingLabel ?? submitButton.textContent; }
              if (status instanceof HTMLElement) { status.dataset.state = "sending"; status.textContent = ""; }
              try {
                const response = await fetch(endpoint, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ ...payload, consentToContact: formData.get("consentToContact") === "true", formStartedAt: Number(payload.formStartedAt) }) });
                const result = await readJson(response);
                if (!response.ok) {
                  const code = stringStatus(result, "code", "");
                  const reason = response.status === 429 || code === "rate_limited" ? "rate_limited" : response.status === 400 || code === "validation_error" ? "validation_failed" : code.includes("email") || code.includes("provider") ? "email_delivery_failed" : "backend_unavailable";
                  dispatchContactAnalytics("contact_form_submit_failed", { failure_reason: reason });
                  const message = reason === "rate_limited" ? form.dataset.rateLimitedMessage : reason === "validation_failed" ? form.dataset.validationMessage : reason === "email_delivery_failed" ? form.dataset.emailErrorMessage : form.dataset.backendErrorMessage;
                  if (status instanceof HTMLElement) { status.dataset.state = "error"; status.textContent = messageWithRetry(message, form.dataset.retryLabel); }
                  return;
                }
                const notificationStatus = stringStatus(result, "notificationStatus", "unknown");
                const analyticsStatus = stringStatus(result, "analyticsStatus", "unknown");
                const deliveryDegraded = notificationStatus === "failed" || notificationStatus === "skipped";
                dispatchContactAnalytics("contact_form_submit_succeeded", { notification_status: notificationStatus, analytics_status: analyticsStatus, delivery_degraded: deliveryDegraded });
                form.reset();
                syncPreferredContactRequirements();
                if (status instanceof HTMLElement) { status.dataset.state = deliveryDegraded ? "warning" : "success"; status.textContent = deliveryDegraded ? form.dataset.degradedSuccessMessage ?? form.dataset.successMessage ?? "" : form.dataset.successMessage ?? ""; }
              } catch {
                dispatchContactAnalytics("contact_form_submit_failed", { failure_reason: "backend_unavailable" });
                if (status instanceof HTMLElement) { status.dataset.state = "error"; status.textContent = messageWithRetry(form.dataset.backendErrorMessage, form.dataset.retryLabel); }
              } finally {
                if (submitButton instanceof HTMLButtonElement) { submitButton.disabled = false; submitButton.textContent = submitButton.dataset.submitLabel ?? submitButton.textContent; }
              }
            });
          }
        </script>
      </>
    ) : isPrivacy && privacyContent ? (
      <>
        <section class="ma-hero ma-grid solo" aria-labelledby="privacy-title" data-privacy-content-id={id}>
          <div class="ma-hero-text" data-ma-block>
            <p class="ma-kicker" data-ma-node="before">{labels.privacyRail}</p>
            <h1 id="privacy-title">{privacyContent.heading}</h1>
            <p class="ma-lede">{privacyContent.intro}</p>
          </div>
        </section>
        <section class="ma-section ma-grid" aria-labelledby="privacy-sections-title">
          <div class="ma-block pos-right" data-ma-block>
            <h2 id="privacy-sections-title" class="ma-kicker" data-ma-node="before" data-ma-color={pastel(2)}>{privacyContent.heading}</h2>
            <ol class="ma-list">{privacyContent.sections.map((section) => <li><div><h3>{section.title}</h3><p>{section.body}</p></div></li>)}</ol>
            <p class="ma-muted">{privacyContent.boundaryNote}</p>
          </div>
        </section>
      </>
    ) : (
      <section class="ma-hero ma-grid solo" aria-labelledby="route-title" data-content-type={node.type}>
        <div class="ma-hero-text" data-ma-block>
          <h1 id="route-title" data-ma-node="before">{variant.title}</h1>
          <p class="ma-lede">{variant.summary}</p>
        </div>
      </section>
    )}
  </div>
)}

<script>
  import { mountLensViewTransitionSource, mountMaLine } from "../scripts/ma-line";

  for (const container of document.querySelectorAll<HTMLElement>("[data-ma]")) mountMaLine(container);
  mountLensViewTransitionSource();
</script>
