---
import {
  getArchitecturePageContent,
  getCaseStudyIndexContent,
  getCaseStudyPageContent,
  getLocalizedPath,
  getPracticePageContent,
  getPrivacyPageContent,
  getResumePageContent,
  type ContentId,
  type PublicRoute,
} from "@aohys/content-graph";
import { LEAD_INTENTS, type LeadIntent } from "@aohys/core/domain";
import { DASHBOARD_PUBLIC_MEDIA_BY_CONTENT_ID } from "../generated/dashboard-public-media";
import { DASHBOARD_PUBLIC_SETTINGS } from "../generated/dashboard-public-settings";
import { getUiCopy } from "../i18n";
import HorizonteHome from "./horizonte/HorizonteHome.astro";
import MaLens from "./horizonte/MaLens.astro";
import { HORIZONTE_PASTELS, HORIZONTE_PROJECTS, PAGE_LENS_PHOTOS, fitStyle, getHorizonteProject } from "./horizonte/projects";
import { resolveProofMedia } from "./horizonte/proof-media";

interface Props { route: PublicRoute; }

const { route } = Astro.props;
const { id, locale, node, variant } = route;
const uiCopy = getUiCopy(locale);
const hz = uiCopy.horizonte;
const labels = uiCopy.publicContent;
const contactCopy = uiCopy.contactForm;
const leadIntentLabels = {
  project: contactCopy.intentProject,
  hiring: contactCopy.intentHiring,
  "architecture-review": contactCopy.intentArchitecture,
  website: contactCopy.intentWebsite,
  other: contactCopy.intentOther,
} satisfies Record<LeadIntent, string>;
const caseStudyIndexContent = getCaseStudyIndexContent(locale);
const architectureContent = id === "architecture" ? getArchitecturePageContent(locale) : undefined;
const practiceContent = id === "practice" ? getPracticePageContent(locale) : undefined;
const caseStudyContent = node.type === "case-study" ? getCaseStudyPageContent(id, locale) : undefined;
const resumeContent = node.type === "resume" ? getResumePageContent(locale) : undefined;
const privacyContent = node.type === "privacy" ? getPrivacyPageContent(locale) : undefined;
const isHome = id === "home";
const isPractice = id === "practice";
const isArchitecture = id === "architecture";
const isWorkIndex = node.type === "case-study-index";
const isCaseStudy = node.type === "case-study";
const isResume = node.type === "resume";
const isContact = node.type === "contact";
const isPrivacy = node.type === "privacy";
const contactEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? "";
const publicContactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL ?? "alejandro.ortiz@aohys.com";
const publicWhatsAppUrl = DASHBOARD_PUBLIC_SETTINGS.PUBLIC_WHATSAPP_URL ?? import.meta.env.PUBLIC_WHATSAPP_URL ?? "https://wa.me/522299020825";
const directEmailHref = `mailto:${publicContactEmail}`;
const contactHref = getLocalizedPath("contact", locale);
const workHref = getLocalizedPath("case-studies", locale);

const PASTEL_CYCLE = [HORIZONTE_PASTELS.honey, HORIZONTE_PASTELS.apricot, HORIZONTE_PASTELS.olive];
const pastel = (index: number) => PASTEL_CYCLE[index % PASTEL_CYCLE.length];

function localizedHref(contentId?: ContentId) {
  return contentId ? getLocalizedPath(contentId, locale) : undefined;
}
const routeActions = [
  { label: variant.primaryActionLabel, href: localizedHref(variant.primaryActionContentId), contentId: variant.primaryActionContentId },
  { label: variant.secondaryActionLabel, href: localizedHref(variant.secondaryActionContentId), contentId: variant.secondaryActionContentId },
].filter((action): action is { label: string; href: string; contentId: ContentId } => Boolean(action.label && action.href && action.contentId));
const secondaryRouteActions = routeActions.filter((action) => action.contentId !== "contact");

/* Case study */
const caseProject = isCaseStudy ? getHorizonteProject(String(id)) : undefined;
const rawCaseMedia = isCaseStudy && caseStudyContent
  ? resolveProofMedia(String(id), caseStudyContent.publicEvidence[0]?.src, caseStudyContent.publicEvidence[0]?.altText, caseStudyContent.publicEvidence[0]?.kind, true)
  : undefined;
const hasDashboardMediaOverride = (contentId?: string) => {
  if (!contentId) return false;
  const media = DASHBOARD_PUBLIC_MEDIA_BY_CONTENT_ID[contentId];
  return Boolean(media?.src || media?.thumbSrc);
};
const localizeDiagramSrc = (src: string, contentId?: string) => {
  if (!hasDashboardMediaOverride(contentId)) {
    if (contentId === "case-study:eteria") return "/images/proof/eteria-live-landing.png";
    if (contentId === "case-study:the-barber-central") return "/images/proof/barber-central-live-hero.png";
    if (contentId === "case-study:casa-roca") return "/images/proof/casa-roca-gallery-clean.png";
    if (contentId === "case-study:nutri-plan") return "/images/proof/nutri-plan-table-clean.png";
  }
  if (locale !== "es") return src;
  if (src === "/images/proof/enterprise-systems-map-v2.svg") return "/images/proof/enterprise-systems-map-v2-es.svg";
  if (src === "/images/proof/engineering-practice-release-cycle.svg") return "/images/proof/engineering-practice-release-cycle-es.svg";
  return src;
};
const caseMedia = rawCaseMedia ? { ...rawCaseMedia, src: localizeDiagramSrc(rawCaseMedia.src, String(id)) } : undefined;
const isNutriLibraryImage = caseMedia?.src === "/images/proof/nutri-plan-table-clean.png";
const normalizePath = (p: string) => p.replace(/\/+$/, "") || "/";
const caseLiveLinks = caseStudyContent?.publicEvidence.filter((evidence) => evidence.href && normalizePath(evidence.href) !== normalizePath(route.path)) ?? [];
const caseOrder = caseStudyIndexContent.entries;
const caseIndex = caseOrder.findIndex((entry) => entry.contentId === id);
const nextCase = caseIndex >= 0 ? caseOrder[(caseIndex + 1) % caseOrder.length] : undefined;
const nextProject = nextCase ? getHorizonteProject(String(nextCase.contentId)) : undefined;
const rawNextMedia = nextCase ? resolveProofMedia(String(nextCase.contentId)) : undefined;
const nextMedia = rawNextMedia ? { ...rawNextMedia, src: localizeDiagramSrc(rawNextMedia.src, String(nextCase?.contentId ?? "")) } : undefined;
const closeCtaCopy = locale === "es"
  ? { heading: "¿Tienes un sistema o producto en mente?", body: "Cuéntame el contexto y te respondo personalmente con un siguiente paso concreto." }
  : { heading: "Have a product or system in mind?", body: "Share the context and I will reply personally with a practical next step." };
const releaseCycleSteps = locale === "es"
  ? [
      { label: "Alcance", title: "Intención y reglas", body: "Criterios escritos antes de editar.", owner: "Responsable: humano" },
      { label: "Cambio", title: "PR acotado", body: "Lint, tipos y build en cada edición.", owner: "Responsable: agente + revisión" },
      { label: "Evidencia", title: "Pruebas reales", body: "Navegador y smoke en preview.", owner: "Responsable: verificador" },
      { label: "Publicación", title: "Promoción", body: "develop → main con reversión lista.", owner: "Responsable: aprobación humana" },
    ]
  : [
      { label: "Scope", title: "Intent & rules", body: "Written criteria before any edit.", owner: "Owner: Human" },
      { label: "Build", title: "Scoped PR", body: "Lint, types & build on every change.", owner: "Owner: Agent + Review" },
      { label: "Evidence", title: "Real checks", body: "Browser & smoke on preview deploy.", owner: "Owner: Fresh verifier" },
      { label: "Release", title: "Promotion", body: "develop → main with rollback path.", owner: "Owner: Human sign-off" },
    ];
const workedReleaseExample = locale === "es"
  ? [
      { label: "01 · Alcance", title: "Alcance del cambio", body: "Criterios observables por pantalla antes de editar un archivo.", artifact: "Especificación del PR" },
      { label: "02 · Validación", title: "Controles estáticos", body: "Lint, tokens de marca, TypeScript y build completo de Astro.", artifact: "Certificación de CI" },
      { label: "03 · Evidencia", title: "Revisión y navegador", body: "Lectura independiente del diff y verificación real en 320px y 1440px.", artifact: "Recibos y capturas" },
      { label: "04 · Producción", title: "Promoción verificada", body: "Fusión develop → main y smoke checks en aohys.com.", artifact: "Release PR #240" },
    ]
  : [
      { label: "01 · Scope", title: "Change contract", body: "Observable user-visible criteria recorded before editing any file.", artifact: "PR acceptance scope" },
      { label: "02 · Validation", title: "Static checks", body: "Lint, brand tokens, TypeScript, and full Astro static build.", artifact: "CI certification" },
      { label: "03 · Evidence", title: "Fresh review & QA", body: "Independent code review plus real browser keyboard and layout checks.", artifact: "Receipts & captures" },
      { label: "04 · Production", title: "Verified release", body: "Protected develop → main merge with live smoke checks on aohys.com.", artifact: "Public PR #240" },
    ];
const enterpriseFlow = locale === "es"
  ? {
      scopeKicker: "Ejemplo anonimizado · Crédito y soporte",
      scopeDomains: "Crédito · Salud · E-commerce · Despacho de emergencias",
      beforeLabel: "Antes · trabajo manual y aislado",
      afterLabel: "Después · flujo auditable en producción",
      pairs: [
        { before: "Hojas de cálculo y correos dispersos para corregir datos de préstamos", after: "Solicitud validada dentro de la app con reglas explícitas de negocio" },
        { before: "Aprobaciones sin trazabilidad ni límites claros por rol", after: "Revisión y aprobación por rol con registro auditable de cada decisión" },
        { before: "Correcciones manuales propensas a error entre equipos", after: "Estado operativo real visible para soporte, socios y liderazgo" },
      ],
    }
  : {
      scopeKicker: "Anonymized example · Lending & support",
      scopeDomains: "Lending · Healthcare · E-commerce · Emergency dispatch",
      beforeLabel: "Before · manual, fragmented handoffs",
      afterLabel: "After · reviewable production workflow",
      pairs: [
        { before: "Spreadsheets and scattered email threads for loan-data corrections", after: "Validated in-app request with explicit domain rules" },
        { before: "Approvals without role boundaries or an audit trail", after: "Role-based review and approval with every decision recorded" },
        { before: "Error-prone manual updates across disconnected systems", after: "Live operational state visible to support, partners, and leadership" },
      ],
    };
const isEngineeringCase = id === "case-study:engineering-practice";
const isBarberCase = id === "case-study:the-barber-central";
const isCasaRocaCase = id === "case-study:casa-roca";
const isEteriaCase = id === "case-study:eteria";
const isNutriCase = id === "case-study:nutri-plan";
const isEnterpriseCase = id === "case-study:enterprise-systems";
const cleanDisplayTitle = (rawTitle: string) =>
  rawTitle
    .replace("event-business", "event\u2011business")
    .replace("patient-care", "patient\u2011care");
const splitBrandTitle = (rawTitle: string): { brand?: string; rest: string } => {
  const clean = cleanDisplayTitle(rawTitle);
  for (const brand of ["The Barber Central", "Casa Roca", "ETERIA", "NutriPlan"]) {
    if (clean.startsWith(`${brand}:`)) {
      return { brand: `${brand}:`, rest: clean.slice(brand.length + 1).trim() };
    }
    if (clean.startsWith(`${brand} `)) {
      return { brand, rest: clean.slice(brand.length).trim() };
    }
  }
  return { rest: clean };
};
const heroTitleParts = splitBrandTitle(variant.title);
const localizeLabel = (text: string) => {
  if (locale !== "es") {
    return text
      .replace("Live hospitality experience", "Hospitality · In production")
      .replace(/^Live website$/, "Live Casa Roca website")
      .replaceAll("'", "\u2019");
  }
  return text
    .replace("Acercándose a producción", "Próximamente en producción")
    .replace("Testing y preparación para producción", "Pruebas y preparación para producción")
    .replace("Testing y preparación", "Pruebas y preparación")
    .replace("Experiencia de hospitalidad en producción", "Hospitalidad · En producción")
    .replace("Landing ETERIA en producción", "Sitio público de ETERIA")
    .replace("Preview de producto", "Vista previa del producto")
    .replace("Preview de desarrollo", "Vista previa de desarrollo")
    .replace("Sitio en producción", "Sitio de Casa Roca")
    .replace("Source y proceso", "Código y proceso")
    .replace("Revisar el source", "Revisar el código")
    .replace(/^Release Train$/, "Tren de entregas")
    .replace(/^Environment Contract$/, "Contrato de entorno")
    .replace(/^Public Content Graph$/, "Grafo de contenido público");
};
const caseFigureCaption = (() => {
  if (isEteriaCase) {
    return locale === "es"
      ? "Sitio público de ETERIA en producción: punto de entrada para consultas y agendamiento por WhatsApp."
      : "Live ETERIA website: public inquiry and WhatsApp booking entry point.";
  }
  if (isCasaRocaCase) {
    return locale === "es"
      ? "Sitio público de Casa Roca en producción: galerías y recorrido previo a la reservación."
      : "Live Casa Roca website: galleries and guest discovery entry point before booking.";
  }
  if (isBarberCase) {
    return locale === "es"
      ? "Central Belleza (marca pública de The Barber Central): agenda, reservas y WhatsApp en una sola vista."
      : "Central Belleza (public brand of The Barber Central): booking, schedule, and WhatsApp in one workflow.";
  }
  if (isNutriCase) {
    return locale === "es"
      ? "Biblioteca clínica sanitizada de NutriPlan Digital: categorías educativas del sistema sin datos de pacientes."
      : "Sanitized NutriPlan Digital clinical content library (Spanish UI): system nutrition categories with no patient data.";
  }
  return caseStudyContent?.publicEvidence[0]?.description ?? "";
})();
const resumeProjectCaseMap: Record<string, ContentId> = {
  "The Barber Central": "case-study:the-barber-central",
  NutriPlan: "case-study:nutri-plan",
  ETERIA: "case-study:eteria",
  "Casa Roca": "case-study:casa-roca",
  "AOHYS website": "architecture",
  "Sitio web de AOHYS": "architecture",
};
const splitParagraph = (text: string): string[] => {
  const markers = ["An anonymous identifier", "Un identificador anónimo"];
  for (const m of markers) {
    const idx = text.indexOf(m);
    if (idx > 0) return [text.slice(0, idx).trim(), text.slice(idx).trim()];
  }
  return [text];
};
const practiceProofCases = locale === "es"
  ? [
      { id: "case-study:the-barber-central" as const, label: "Caso: The Barber Central (reservas y operación)" },
      { id: "case-study:enterprise-systems" as const, label: "Caso: sistemas empresariales y flujos de revisión" },
      { id: "case-study:engineering-practice" as const, label: "Caso: ingeniería con agentes y ciclo de entrega" },
    ]
  : [
      { id: "case-study:the-barber-central" as const, label: "Case study: The Barber Central (booking & operations)" },
      { id: "case-study:enterprise-systems" as const, label: "Case study: Enterprise systems & review workflows" },
      { id: "case-study:engineering-practice" as const, label: "Case study: How I work with coding agents" },
    ];
/* Diagrams and maps are shown whole inside an orb; photographs and screens fill it. */
const DIAGRAM_KINDS = new Set(["diagram", "architecture-note", "private-system"]);
const orbImageClass = (kind?: string) => (kind && DIAGRAM_KINDS.has(kind) ? "contain" : "cover");


/* Accessible name for the work-index lens; single photographs use their own alt text. */
const lensLabels = {
  work: locale === "es" ? "Lente que recorre los cinco productos." : "Lens cycling through the five products.",
};
---

{isHome ? (
  <HorizonteHome locale={locale} contentId={String(id)} />
) : (
  <div class="ma" data-ma data-page={isResume ? "resume" : isContact ? "contact" : isPractice ? "practice" : node.type}>
    <svg class="ma-line" aria-hidden="true" focusable="false"></svg>

    {isCaseStudy && caseStudyContent && caseMedia ? (
      <article data-case-study-content-id={id} style={caseProject ? `--tint:${caseProject.tint}` : undefined}>
        <header class="ma-hero ma-grid">
          <div class="ma-hero-text" data-ma-block>
            <a class="ma-back" href={workHref} data-ma-node="before"><span aria-hidden="true">←</span> {hz.back}</a>
            <p class="ma-kicker">{localizeLabel(caseStudyContent.statusLabel)}</p>
            <h1>{heroTitleParts.brand ? <><span class="ma-nowrap">{heroTitleParts.brand}</span> {heroTitleParts.rest}</> : heroTitleParts.rest}</h1>
            <p class="ma-lede">{caseStudyContent.overview}</p>
            <nav class="ma-actions" aria-label={hz.caseLinks}>
              {caseLiveLinks.map((evidence) => (
                <a class="hz-link" href={evidence.href} rel="noopener" target="_blank" aria-label={evidence.altText}>{localizeLabel(evidence.label)} <span aria-hidden="true">↗</span></a>
              ))}
              <a class="ma-cue" href="#case-need">{hz.scrollCue}</a>
            </nav>
          </div>
          {isEnterpriseCase ? (
            <div class="ma-hero-proof" aria-label={caseMedia.alt}>
              <span class="ma-kicker">{enterpriseFlow.scopeKicker}</span>
              <div class="ma-proof-pair">
                <div>
                  <span class="ma-proof-tag">{locale === "es" ? "Antes" : "Before"}</span>
                  <p class="ma-proof-before">{enterpriseFlow.pairs[0]!.before}</p>
                </div>
                <span class="ma-proof-arrow" aria-hidden="true">↓</span>
                <div>
                  <span class="ma-proof-tag">{locale === "es" ? "Después" : "After"}</span>
                  <p class="ma-proof-after">{enterpriseFlow.pairs[0]!.after}</p>
                </div>
              </div>
              <p class="ma-meta-line">{enterpriseFlow.scopeDomains}</p>
            </div>
          ) : isEngineeringCase ? (
            <div class="ma-hero-proof" aria-label={caseMedia.alt}>
              <span class="ma-kicker">{locale === "es" ? "Ciclo de entrega" : "Delivery cycle"}</span>
              <ol class="ma-proof-steps">
                {releaseCycleSteps.map((step, i) => (
                  <li><span class="hz-num">{`0${i + 1}`}</span><strong>{step.title}</strong><span>{step.body}</span></li>
                ))}
              </ol>
            </div>
          ) : (
            <figure class={`${caseProject ? "ma-hero-orb hz-fit" : "ma-hero-orb"}${isCasaRocaCase ? " ma-orb-warm" : ""}`} style={caseProject ? fitStyle(caseProject) : undefined}>
              {caseProject
                ? <img src={caseProject.texture} alt={caseProject.alt[locale]} fetchpriority="high" />
                : <img class={orbImageClass(caseMedia.kind)} src={caseMedia.src} alt={caseMedia.alt} fetchpriority="high" />}
            </figure>
          )}
        </header>

        <section class="ma-section ma-grid" id="case-need" aria-labelledby="case-need-title">
          <div class="ma-block pos-left" data-ma-block>
            <h2 id="case-need-title" class="ma-kicker" data-ma-node="before" data-ma-color={pastel(0)}>{labels.businessNeed}</h2>
            <p class="ma-statement">{caseStudyContent.problem.body}</p>
          </div>
        </section>

        <section class="ma-section ma-grid" aria-labelledby="case-built-title">
          <div class="ma-block pos-right" data-ma-block>
            <h2 id="case-built-title" data-ma-node="before" data-ma-color={pastel(1)}>{caseStudyContent.businessOutcome.title}</h2>
            <p>{caseStudyContent.businessOutcome.body}</p>
            <div class="ma-pairs">
              <div><h3>{caseStudyContent.role.title}</h3><p>{caseStudyContent.role.body}</p></div>
            </div>
          </div>
        </section>

        <section class="ma-section ma-grid" aria-labelledby="case-interface-title">
          <div class="ma-block pos-wide" data-ma-block>
            <h2 id="case-interface-title" data-ma-node="before" data-ma-color={pastel(0)}>
              {isEnterpriseCase
                ? (locale === "es" ? "Antes y después" : "Before and after")
                : isEngineeringCase
                  ? (locale === "es" ? "Un cambio real en producción (aohys.com)" : "One worked release on aohys.com")
                  : (caseLiveLinks.length > 0 ? caseStudyContent.publicEvidenceTitle : (locale === "es" ? "Evidencia del sistema" : "System evidence"))}
            </h2>
            {isEnterpriseCase ? (
              <>
                <div class="ma-flow-pairs" aria-label={caseMedia.alt}>
                  <div class="ma-flow-head" aria-hidden="true">
                    <span class="ma-kicker">{enterpriseFlow.beforeLabel}</span>
                    <span class="ma-kicker">{enterpriseFlow.afterLabel}</span>
                  </div>
                  {enterpriseFlow.pairs.map((pair, i) => (
                    <div class="ma-flow-row">
                      <span class="hz-num">{`0${i + 1}`}</span>
                      <div class="ma-flow-cell">
                        <span class="ma-flow-mobile-label">{locale === "es" ? "Antes" : "Before"}</span>
                        <p>{pair.before}</p>
                      </div>
                      <div class="ma-flow-cell ma-flow-cell-after">
                        <span class="ma-flow-mobile-label">{locale === "es" ? "Después" : "After"}</span>
                        <p>{pair.after}</p>
                      </div>
                    </div>
                  ))}
                </div>
                <p class="ma-privacy-note ma-privacy-note-wide">{caseStudyContent.confidentialityNote.body}</p>
              </>
            ) : isEngineeringCase ? (
              <div class="ma-cycle-wrap">
                <ol class="ma-cycle" aria-label={caseMedia.alt}>
                  {workedReleaseExample.map((step, i) => (
                    <li style={`--step-tint:${pastel(i)}`}>
                      <span class="ma-kicker">{step.label}</span>
                      <h3>{step.title}</h3>
                      <p>{step.body}</p>
                      <span class="ma-cycle-owner">{step.artifact}</span>
                    </li>
                  ))}
                </ol>
                <div class="ma-links ma-cycle-link">
                  <a class="hz-link" href="https://github.com/AO-HyS/aohys.com/pull/240" rel="noopener" target="_blank">{locale === "es" ? "Ver PR público #240 en GitHub" : "Inspect public release PR #240 on GitHub"} <span aria-hidden="true">↗</span></a>
                  {caseLiveLinks[0] && (
                    <a class="hz-link" href={caseLiveLinks[0].href} rel="noopener" target="_blank">{locale === "es" ? "Repositorio en GitHub" : "Public repository"} <span aria-hidden="true">↗</span></a>
                  )}
                </div>
              </div>
            ) : (
              <>
                <figure class:list={["ma-frame", { "ma-frame-library": isNutriLibraryImage }]}>
                  <img src={caseMedia.src} alt={caseMedia.alt} loading="eager" decoding="sync" />
                  <figcaption>
                    {caseFigureCaption && <span>{caseFigureCaption}</span>}
                    {isNutriLibraryImage && (
                      <a class="hz-link ma-frame-full-link" href={caseMedia.src} target="_blank" rel="noopener">{locale === "es" ? "Ver la captura completa" : "View the full screenshot"} <span aria-hidden="true">↗</span></a>
                    )}
                    {caseLiveLinks[0] && (
                      <a class="hz-link" href={caseLiveLinks[0].href} rel="noopener" target="_blank">{localizeLabel(caseLiveLinks[0].label)} <span aria-hidden="true">↗</span></a>
                    )}
                  </figcaption>
                </figure>
                {isBarberCase && (
                  <figure class="ma-frame ma-frame-secondary">
                    <img src="/images/proof/barber-central-ops.png" alt={locale === "es" ? "Panel operativo sanitizado de The Barber Central con resumen de organizaciones y citas." : "Sanitized operations dashboard of The Barber Central showing organization and appointment metrics."} loading="eager" decoding="sync" />
                    <figcaption>
                      <span>{locale === "es" ? "Panel operativo interno (datos sanitizados): organizaciones, adopción y citas." : "Sanitized internal operations dashboard: organizations, adoption, and appointments (Spanish UI)."}</span>
                    </figcaption>
                  </figure>
                )}
              </>
            )}
          </div>
        </section>

        <section class="ma-section ma-grid" aria-labelledby="case-decisions-title">
          <div class="ma-block pos-left" data-ma-block>
            <h2 id="case-decisions-title" data-ma-node="before" data-ma-color={pastel(2)}>{caseStudyContent.architectureDecisions.title}</h2>
            <div class="ma-pairs">
              <div><h3>{labels.considerations}</h3><p>{caseStudyContent.constraints.body}</p></div>
              <div><h3>{locale === "es" ? "Decisiones clave" : "Key decisions"}</h3><p>{caseStudyContent.architectureDecisions.body}</p></div>
            </div>
          </div>
        </section>

        <section class="ma-section ma-grid" aria-labelledby="case-delivery-title">
          <div class="ma-block pos-right" data-ma-block>
            <h2 id="case-delivery-title" data-ma-node="before" data-ma-color={pastel(1)}>{caseStudyContent.executionHighlights.title}</h2>
            <p>{caseStudyContent.executionHighlights.body}</p>
            <div class="ma-pairs">
              <div><h3>{caseStudyContent.qualitySecurityPerformance.title}</h3><p>{caseStudyContent.qualitySecurityPerformance.body}</p></div>
            </div>
          </div>
        </section>

        <section class="ma-section ma-grid ma-close" aria-labelledby="case-close-title">
          <div class="ma-block pos-wide" data-ma-block>
