---
import { getAlternateLocale, getLocalizedPath, getPublicNavigation, type ContentId, type Locale } from "@aohys/content-graph";
import { getUiCopy } from "../i18n";

interface Props {
  locale?: Locale;
  currentId?: ContentId | string;
}

const { locale = "en", currentId = "home" } = Astro.props;
const alternateLocale = getAlternateLocale(locale);
const copy = getUiCopy(locale).header;
const navigation = getPublicNavigation(locale);
const languageHref = getLocalizedPath(currentId, alternateLocale);
const contactAction = navigation.actions.find((action) => action.contentId === "contact");
const navOrder = ["case-studies", "architecture", "practice", "resume"];
const navItems = navOrder
  .map((contentId) => navigation.items.find((item) => item.contentId === contentId))
  .filter((item): item is NonNullable<typeof item> => Boolean(item));

function isCurrent(contentId?: string) {
  if (!contentId) return false;
  if (contentId === "case-studies") return currentId === "case-studies" || currentId.startsWith("case-study:");
  return currentId === contentId;
}
---

<header class="hz-header" data-hz-header>
  <a class="hz-skip" href="#main-content">{copy.skip}</a>
  <nav class="hz-nav" aria-label={copy.aria}>
    <a class="hz-wordmark" href={getLocalizedPath("home", locale)} aria-label={navigation.brand.homeLabel}>
      <strong>AOHYS</strong>
      <span aria-hidden="true">Alejandro Ortiz Corro</span>
    </a>

    <div class="hz-links">
      {navItems.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.contentId) ? "page" : undefined}>{item.label}</a>
      ))}
    </div>

    <div class="hz-actions">
      <a class="hz-lang" href={languageHref} hreflang={alternateLocale}>{copy.language}</a>
      {contactAction && <a class="hz-talk" href={contactAction.href} aria-current={currentId === "contact" ? "page" : undefined}>{contactAction.label}</a>}
      <button
        class="hz-menu"
        type="button"
        aria-expanded="false"
        aria-controls="hz-mobile-panel"
        data-menu-label-open={copy.menu}
        data-menu-label-close={copy.menuClose}
        aria-label={copy.menu}
        data-menu-trigger
      >{locale === "es" ? "Menú" : "Menu"}</button>
    </div>

    <div class="hz-mobile-panel" id="hz-mobile-panel" hidden data-menu-panel>
      {navItems.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.contentId) ? "page" : undefined}>{item.label}</a>
      ))}
      {contactAction && <a href={contactAction.href} aria-current={currentId === "contact" ? "page" : undefined}>{contactAction.label}</a>}
    </div>
  </nav>
</header>

<script>
  for (const header of document.querySelectorAll<HTMLElement>("[data-hz-header]")) {
    const trigger = header.querySelector("[data-menu-trigger]");
    const panel = header.querySelector("[data-menu-panel]");

    const onScroll = () => header.setAttribute("data-scrolled", String(window.scrollY > 8));
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });

    if (!(trigger instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) continue;

    const setOpen = (isOpen: boolean) => {
      const label = isOpen ? trigger.dataset.menuLabelClose : trigger.dataset.menuLabelOpen;
      trigger.setAttribute("aria-expanded", String(isOpen));
      if (label) trigger.setAttribute("aria-label", label);
      panel.hidden = !isOpen;
    };

    trigger.addEventListener("click", () => setOpen(trigger.getAttribute("aria-expanded") !== "true"));
    header.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && trigger.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        trigger.focus();
      }
    });
    header.addEventListener("focusout", (event) => {
      const next = event.relatedTarget;
      if (!(next instanceof Node) || !header.contains(next)) setOpen(false);
    });
  }
</script>
