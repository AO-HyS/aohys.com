---
import "@fontsource/spectral/latin-300.css";
import "@fontsource/spectral/latin-300-italic.css";
import "@fontsource-variable/jost/wght.css";
import "../styles/horizonte.css";
import AohysLogo from "../components/horizonte/AohysLogo.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>Page not found | AOHYS</title>
  </head>
  <body class="hz-404">
    <main>
      <a class="hz-wordmark" href="/" aria-label="AOHYS"><AohysLogo /></a>
      <span class="orb" aria-hidden="true"></span>
      <p class="ma-kicker">404</p>
      <h1>This page drifted out of orbit.</h1>
      <p class="lede" lang="es">Esta página salió de su órbita.</p>
      <p>The address may have changed, or the page may no longer exist.</p>
      <nav aria-label="Recovery links">
        <a class="hz-link" href="/">Back home <span aria-hidden="true">→</span></a>
        <a class="hz-link" href="/case-studies/">Selected work <span aria-hidden="true">→</span></a>
        <a class="hz-link" href="/es/" hreflang="es" lang="es">Ver el sitio en español <span aria-hidden="true">→</span></a>
      </nav>
    </main>
  </body>
</html>

<style>
  .hz-404 {
    margin: 0;
    min-height: 100svh;
    display: grid;
    place-items: center;
    background:
      radial-gradient(46% 40% at 50% 46%, color-mix(in oklab, var(--apricot) 42%, transparent), transparent 72%),
      var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-weight: 350;
    line-height: 1.6;
  }
  main {
    display: grid;
    justify-items: center;
    gap: 14px;
    width: min(40rem, calc(100% - 2.5rem));
    padding: 3rem 0;
    text-align: center;
  }
  .hz-wordmark .hz-logo {
    width: 88px;
  }
  .orb {
    width: 132px;
    height: 132px;
    margin: 28px 0 12px;
    border-radius: 50%;
    background: radial-gradient(circle at 34% 30%, #fff 0 16%, var(--apricot) 62%, var(--honey) 100%);
    box-shadow: 0 0 0 1px rgba(71, 60, 51, 0.16), 0 0 0 10px #fff, 0 18px 70px -4px color-mix(in oklab, var(--apricot) 80%, transparent);
    animation: drift 9s ease-in-out infinite alternate;
  }
  @keyframes drift {
    from { transform: translate3d(-10px, 4px, 0); }
    to { transform: translate3d(10px, -6px, 0); }
  }
  h1 {
    margin: 0;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(2.2rem, 1.4rem + 3vw, 3.6rem);
    line-height: 1.06;
    text-wrap: balance;
  }
  .lede {
    margin: 0;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: 1.25rem;
  }
  p {
    margin: 0;
    color: var(--ink-soft);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 26px;
    margin-top: 18px;
  }
  @media (prefers-reduced-motion: reduce) {
    .orb { animation: none; }
  }
</style>
