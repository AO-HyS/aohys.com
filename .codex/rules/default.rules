prefix_rule(pattern=["/bin/zsh", "-lc", "node -e \"const fs=require('fs'); const { request }=require('playwright'); const env={}; for(const f of ['.env.playwright.local','apps/dashboard/.env.local']) if(fs.existsSync(f)) for(const l of fs.readFileSync(f,'utf8').split(/\\n/)){ const s=l.trim(); if(!s||s.startsWith('#')) continue; const i=s.indexOf('='); if(i>0 && !(s.slice(0,i) in env)) env[s.slice(0,i).trim()]=s.slice(i+1).trim().replace(/^['\\\"]|['\\\"]$/g,''); } (async()=>{ const origin='http://127.0.0.1:3011'; const email=env.PW_ADMIN_EMAIL||env.TEST_ADMIN_EMAIL; const password=env.PW_ADMIN_PASSWORD||env.TEST_ADMIN_PASSWORD; const api=await request.newContext(); const res=await api.post(origin+'/api/auth/sign-in/email',{headers:{'content-type':'application/json',accept:'application/json',origin,referer:origin+'/auth/sign-in'},data:{email,password},timeout:30000,failOnStatusCode:false}); const body=await res.text(); const setCookies=res.headersArray().filter(h=>h.name.toLowerCase()==='set-cookie').map(h=>h.value.split(';')[0].split('=')[0]); console.log(JSON.stringify({status:res.status(), ok:res.ok(), setCookies, bodyPreview:body.slice(0,260)},null,2)); const cookieHeader=res.headersArray().filter(h=>h.name.toLowerCase()==='set-cookie').map(h=>h.value.split(';')[0]).join('; '); const session=await api.get(origin+'/api/auth/get-session',{headers:{accept:'application/json',cookie:cookieHeader},timeout:30000,failOnStatusCode:false}); console.log(JSON.stringify({sessionStatus:session.status(), sessionOk:session.ok(), sessionBody:(await session.text()).slice(0,260)},null,2)); await api.dispose(); })().catch(e=>{console.error(e); process.exit(1)})\""], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "node -e \"const fs=require('fs'); const { request }=require('playwright'); const env={}; for(const f of ['/Users/corrortiz/Documents/AO/nutri-plan/.env.playwright.local','/Users/corrortiz/Documents/AO/nutri-plan/apps/dashboard/.env.local']) if(fs.existsSync(f)) for(const l of fs.readFileSync(f,'utf8').split(/\\n/)){ const s=l.trim(); if(!s||s.startsWith('#')) continue; const i=s.indexOf('='); if(i>0 && !(s.slice(0,i) in env)) env[s.slice(0,i).trim()]=s.slice(i+1).trim().replace(/^['\\\"]|['\\\"]$/g,''); } (async()=>{ const origin='http://127.0.0.1:3011'; const email=env.PW_ADMIN_EMAIL||env.TEST_ADMIN_EMAIL; const password=env.PW_ADMIN_PASSWORD||env.TEST_ADMIN_PASSWORD; const api=await request.newContext(); const res=await api.post(origin+'/api/auth/sign-in/email',{headers:{'content-type':'application/json',accept:'application/json',origin,referer:origin+'/auth/sign-in'},data:{email,password},timeout:30000,failOnStatusCode:false}); const body=await res.text(); const setCookies=res.headersArray().filter(h=>h.name.toLowerCase()==='set-cookie').map(h=>h.value.split(';')[0].split('=')[0]); console.log(JSON.stringify({status:res.status(), ok:res.ok(), setCookies, bodyPreview:body.slice(0,260)},null,2)); const cookieHeader=res.headersArray().filter(h=>h.name.toLowerCase()==='set-cookie').map(h=>h.value.split(';')[0]).join('; '); const session=await api.get(origin+'/api/auth/get-session',{headers:{accept:'application/json',cookie:cookieHeader},timeout:30000,failOnStatusCode:false}); console.log(JSON.stringify({sessionStatus:session.status(), sessionOk:session.ok(), hasSession:(await session.text()).includes('session')},null,2)); await api.dispose(); })().catch(e=>{console.error(e); process.exit(1)})\""], decision="allow")
