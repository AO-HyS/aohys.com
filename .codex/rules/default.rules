prefix_rule(pattern=["pnpm", "qa:pw:local"], decision="allow")
prefix_rule(pattern=["pkill", "-f", "run-playwright-cli.mjs"], decision="allow")
prefix_rule(pattern=["node", "-e", "const fs=require('node:fs'); const path=require('node:path'); (async()=>{ const { chromium }=await import('playwright'); const envMod=await import('./scripts/quality/playwright-env.mjs'); const env=envMod.loadPlaywrightEnvironment('local'); const org=env.env.DASHBOARD_ORG_SLUG; const storage=envMod.getStorageStatePath('local','patient','dashboard'); const outDir=path.join(process.cwd(),'output','browser-qa','local','training-focused'); fs.mkdirSync(outDir,{recursive:true}); const browser=await chromium.launch(); const context=await browser.newContext({ storageState: fs.existsSync(storage)?storage:undefined, viewport:{width:390,height:844}, isMobile:true }); const page=await context.newPage(); const errors=[]; page.on('console', m=>{ if(m.type()==='error' && !/favicon|hydration|Warning:|Response/.test(m.text())) errors.push(m.text()); }); page.on('pageerror', e=>errors.push(e.message)); async function check(name, route){ const url=env.urls.dashboard+route; await page.goto(url,{waitUntil:'domcontentloaded'}); await page.locator('body').waitFor({state:'visible',timeout:10000}); await page.waitForTimeout(1000); const pathname=new URL(page.url()).pathname; if(pathname.includes('/auth/sign-in')) throw new Error(name+' redirected to '+pathname); const metrics=await page.evaluate(()=>({scrollWidth:document.documentElement.scrollWidth, clientWidth:document.documentElement.clientWidth, bodyText:document.body.innerText.slice(0,500)})); if(metrics.scrollWidth>metrics.clientWidth+1) throw new Error(name+' horizontal overflow '+metrics.scrollWidth+' > '+metrics.clientWidth); await page.screenshot({path:path.join(outDir,name+'.png'), fullPage:true}); console.log(JSON.stringify({name, route, finalPath:pathname, width:metrics.clientWidth, scrollWidth:metrics.scrollWidth, bodyText:metrics.bodyText.slice(0,160)})); } await check('exercise-log-mobile','/'+org+'/patient-portal/exercise-log'); await check('exercises-list-mobile','/'+org+'/patient-portal/exercises'); const firstPlanHref=await page.locator('a[href*=/patient-portal/exercises/]').first().getAttribute('href').catch(()=>null); if(firstPlanHref){ await check('exercise-plan-detail-mobile', firstPlanHref.startsWith('http')?new URL(firstPlanHref).pathname:firstPlanHref); } if(errors.length) throw new Error('console/page errors: '+errors.join(' | ')); await context.close(); await browser.close(); })().catch((error)=>{ console.error(error); process.exit(1); });"], decision="allow")
prefix_rule(pattern=["pnpm", "playwright:auth:local"], decision="allow")
prefix_rule(pattern=["pkill", "-f", "playwright-auth-state.mjs"], decision="allow")
prefix_rule(pattern=["pkill", "-f", "vite dev --host localhost --port 3001"], decision="allow")
prefix_rule(pattern=["pnpm", "--filter", "@nutriplan/dashboard", "dev"], decision="allow")
prefix_rule(pattern=["curl", "-I", "http://127.0.0.1:3001"], decision="allow")
prefix_rule(pattern=["true"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "node -e \"const fs=require('fs'); const { request }=require('playwright'); const env={}; for(const f of ['.env.playwright.local','apps/dashboard/.env.local']) if(fs.existsSync(f)) for(const l of fs.readFileSync(f,'utf8').split(/\\n/)){ const s=l.trim(); if(!s||s.startsWith('#')) continue; const i=s.indexOf('='); if(i>0 && !(s.slice(0,i) in env)) env[s.slice(0,i).trim()]=s.slice(i+1).trim().replace(/^['\\\"]|['\\\"]$/g,''); } (async()=>{ const origin='http://127.0.0.1:3001'; const email=env.PW_ADMIN_EMAIL||env.TEST_ADMIN_EMAIL; const password=env.PW_ADMIN_PASSWORD||env.TEST_ADMIN_PASSWORD; const api=await request.newContext(); const res=await api.post(origin+'/api/auth/sign-in/email',{headers:{'content-type':'application/json',accept:'application/json',origin,referer:origin+'/auth/sign-in'},data:{email,password},timeout:30000,failOnStatusCode:false}); const body=await res.text(); const setCookies=res.headersArray().filter(h=>h.name.toLowerCase()==='set-cookie').map(h=>h.value.split(';')[0].split('=')[0]); console.log(JSON.stringify({loginStatus:res.status(), ok:res.ok(), setCookies, bodyPreview:body.slice(0,220)},null,2)); const cookieHeader=res.headersArray().filter(h=>h.name.toLowerCase()==='set-cookie').map(h=>h.value.split(';')[0]).join('; '); for (const path of ['/api/auth/get-session','/api/auth/session']) { const s=await api.get(origin+path,{headers:{accept:'application/json',cookie:cookieHeader},timeout:30000,failOnStatusCode:false}); console.log(JSON.stringify({path,status:s.status(),ok:s.ok(),body:(await s.text()).slice(0,300)},null,2)); } await api.dispose(); })().catch(e=>{console.error(e); process.exit(1)})\""], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "node -e \"const fs=require('fs'); const { request }=require('playwright'); const env={}; for(const f of ['.env.playwright.local','apps/dashboard/.env.local']) if(fs.existsSync(f)) for(const l of fs.readFileSync(f,'utf8').split(/\\n/)){ const s=l.trim(); if(!s||s.startsWith('#')) continue; const i=s.indexOf('='); if(i>0 && !(s.slice(0,i) in env)) env[s.slice(0,i).trim()]=s.slice(i+1).trim().replace(/^['\\\"]|['\\\"]$/g,''); } (async()=>{ const origin='http://127.0.0.1:3001'; const email=env.PW_ADMIN_EMAIL||env.TEST_ADMIN_EMAIL; const password=env.PW_ADMIN_PASSWORD||env.TEST_ADMIN_PASSWORD; const api=await request.newContext(); const res=await api.post(origin+'/api/auth/sign-in/email',{headers:{'content-type':'application/json',accept:'application/json',origin,referer:origin+'/auth/sign-in'},data:{email,password},timeout:30000,failOnStatusCode:false}); const body=await res.text(); const msg=(body.match(/const error = (\\{.*?\\});/s)||[])[1]; if(msg){ const err=JSON.parse(msg); console.log(JSON.stringify({status:res.status(), message:err.message, stack:String(err.stack||'').split('\\n').slice(0,8)},null,2)); } else { console.log(body.slice(0,2000)); } await api.dispose(); })().catch(e=>{console.error(e); process.exit(1)})\""], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "node -e \"const fs=require('fs'); const env={}; for(const f of ['apps/dashboard/.env.local','.env.local','.env.ops.dev']) if(fs.existsSync(f)) for(const l of fs.readFileSync(f,'utf8').split(/\\n/)){ const s=l.trim(); if(!s||s.startsWith('#')) continue; const i=s.indexOf('='); if(i>0 && !(s.slice(0,i) in env)) env[s.slice(0,i).trim()]=s.slice(i+1).trim().replace(/^['\\\"]|['\\\"]$/g,'').split(' # ')[0]; } (async()=>{ const site=env.NEXT_PUBLIC_CONVEX_SITE_URL||env.VITE_CONVEX_SITE_URL||env.CONVEX_SITE_URL; const api=env.NEXT_PUBLIC_CONVEX_URL||env.VITE_CONVEX_URL||env.CONVEX_URL; console.log(JSON.stringify({convexUrlHost:api?new URL(api).host:null, convexSiteHost:site?new URL(site).host:null},null,2)); for(const u of [site && site.replace(/\\/$/,'')+'/api/auth/ok', api]){ if(!u) continue; try{ const r=await fetch(u,{method:'GET'}); console.log(JSON.stringify({host:new URL(u).host,path:new URL(u).pathname,status:r.status,ok:r.ok,body:(await r.text()).slice(0,220)},null,2)); } catch(e){ console.log(JSON.stringify({host:new URL(u).host,path:new URL(u).pathname,error:e.message,cause:e.cause&&String(e.cause)},null,2)); } } })().catch(e=>{console.error(e); process.exit(1)})\""], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "node -e \"const fs=require('fs'); const env={}; for(const f of ['apps/dashboard/.env.local','.env.local','.env.ops.dev']) if(fs.existsSync(f)) for(const l of fs.readFileSync(f,'utf8').split(/\\n/)){ const s=l.trim(); if(!s||s.startsWith('#')) continue; const i=s.indexOf('='); if(i>0 && !(s.slice(0,i) in env)) env[s.slice(0,i).trim()]=s.slice(i+1).trim().replace(/^['\\\"]|['\\\"]$/g,'').split(' # ')[0]; } (async()=>{ const site=env.NEXT_PUBLIC_CONVEX_SITE_URL||env.VITE_CONVEX_SITE_URL||env.CONVEX_SITE_URL; const origin='http://127.0.0.1:3001'; const url=site.replace(/\\/$/,'')+'/api/auth/sign-in/email'; const r=await fetch(url,{method:'POST',headers:{'content-type':'application/json',accept:'application/json','accept-encoding':'application/json',origin,referer:origin+'/auth/sign-in',host:new URL(site).host},body:JSON.stringify({email:'not-a-real-user@example.com',password:'not-secret'})}); console.log(JSON.stringify({status:r.status, ok:r.ok, body:(await r.text()).slice(0,300)},null,2)); })().catch(e=>{console.error(e); process.exit(1)})\""], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "node -e \"const fs=require('fs'); const { request }=require('playwright'); const env={}; for(const f of ['.env.playwright.preview','.env.playwright.local']) if(fs.existsSync(f)) for(const l of fs.readFileSync(f,'utf8').split(/\\n/)){ const s=l.trim(); if(!s||s.startsWith('#')) continue; const i=s.indexOf('='); if(i>0 && !(s.slice(0,i) in env)) env[s.slice(0,i).trim()]=s.slice(i+1).trim().replace(/^['\\\"]|['\\\"]$/g,''); } (async()=>{ const origin='https://fix-pipeline-nutriplan-dashboard.a-ortizcrr.workers.dev'; const email=env.PW_ADMIN_EMAIL; const password=env.PW_ADMIN_PASSWORD; const api=await request.newContext(); const res=await api.post(origin+'/api/auth/sign-in/email',{headers:{'content-type':'application/json',accept:'application/json',origin,referer:origin+'/auth/sign-in'},data:{email,password},timeout:30000,failOnStatusCode:false}); const body=await res.text(); const setCookies=res.headersArray().filter(h=>h.name.toLowerCase()==='set-cookie').map(h=>h.value.split(';')[0].split('=')[0]); console.log(JSON.stringify({origin,status:res.status(), ok:res.ok(), setCookies, bodyPreview:body.slice(0,500)},null,2)); await api.dispose(); })().catch(e=>{console.error(e); process.exit(1)})\""], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "node -e \"const fs=require('fs'); const { request }=require('playwright'); const env={}; for(const f of ['.env.playwright.preview','.env.playwright.local']) if(fs.existsSync(f)) for(const l of fs.readFileSync(f,'utf8').split(/\\n/)){ const s=l.trim(); if(!s||s.startsWith('#')) continue; const i=s.indexOf('='); if(i>0 && !(s.slice(0,i) in env)) env[s.slice(0,i).trim()]=s.slice(i+1).trim().replace(/^['\\\"]|['\\\"]$/g,''); } (async()=>{ for (const origin of ['https://develop-nutriplan-dashboard.a-ortizcrr.workers.dev','https://develop-nutriplan-admin-dashboard.a-ortizcrr.workers.dev']) { const email=origin.includes('admin-dashboard')?(env.PW_SUPERADMIN_EMAIL||env.PW_ADMIN_EMAIL):env.PW_ADMIN_EMAIL; const password=origin.includes('admin-dashboard')?(env.PW_SUPERADMIN_PASSWORD||env.PW_ADMIN_PASSWORD):env.PW_ADMIN_PASSWORD; const api=await request.newContext(); const ok=await api.get(origin,{timeout:30000,failOnStatusCode:false}); console.log(JSON.stringify({origin,rootStatus:ok.status(),rootBody:(await ok.text()).slice(0,80)},null,2)); const res=await api.post(origin+'/api/auth/sign-in/email',{headers:{'content-type':'application/json',accept:'application/json',origin,referer:origin+'/auth/sign-in'},data:{email,password},timeout:30000,failOnStatusCode:false}); const body=await res.text(); const setCookies=res.headersArray().filter(h=>h.name.toLowerCase()==='set-cookie').map(h=>h.value.split(';')[0].split('=')[0]); console.log(JSON.stringify({origin,status:res.status(), ok:res.ok(), setCookies, bodyPreview:body.slice(0,500)},null,2)); await api.dispose(); } })().catch(e=>{console.error(e); process.exit(1)})\""], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "node --input-type=module -e \"import fs from 'node:fs'; import { request } from 'playwright'; import { ConvexHttpClient } from 'convex/browser'; import { api as convexApi } from './packages/convex/src/_generated/api.js'; const env={}; for(const f of ['.env.playwright.preview','.env.playwright.local']) if(fs.existsSync(f)) for(const l of fs.readFileSync(f,'utf8').split(/\\n/)){ const s=l.trim(); if(!s||s.startsWith('#')) continue; const i=s.indexOf('='); if(i>0 && !(s.slice(0,i) in env)) env[s.slice(0,i).trim()]=s.slice(i+1).trim().replace(/^['\\\"]|['\\\"]$/g,''); } const b64json=s=>JSON.parse(Buffer.from(s.replace(/-/g,'+').replace(/_/g,'/'),'base64url').toString('utf8')); const origin='https://develop-nutriplan-dashboard.a-ortizcrr.workers.dev'; const apiReq=await request.newContext(); const res=await apiReq.post(origin+'/api/auth/sign-in/email',{headers:{'content-type':'application/json',accept:'application/json',origin,referer:origin+'/auth/sign-in'},data:{email:env.PW_ADMIN_EMAIL,password:env.PW_ADMIN_PASSWORD},timeout:30000,failOnStatusCode:false}); const cookies=res.headersArray().filter(h=>h.name.toLowerCase()==='set-cookie').map(h=>h.value.split(';')[0]); const jwtCookie=cookies.find(c=>c.startsWith('__Secure-better-auth.convex_jwt=')); const jwt=jwtCookie?.split('=').slice(1).join('='); if(!jwt) throw new Error('missing convex jwt'); const payload=b64json(jwt.split('.')[1]); const issuer=payload.iss || ''; const convexUrl=issuer.endsWith('.convex.site') ? issuer.replace('.convex.site','.convex.cloud') : issuer; console.log(JSON.stringify({jwtIssuerHost: issuer ? new URL(issuer).host : null, convexHost: convexUrl ? new URL(convexUrl).host : null, subjectPresent: Boolean(payload.sub), audience: payload.aud ?? null}, null, 2)); const client=new ConvexHttpClient(convexUrl); client.setAuth(jwt); for (const [name, fn, args] of [['currentUser', convexApi.userAuth.getCurrentUserProfile, {}], ['userOrganizations', convexApi.userAuth.getUserOrganizations, {}], ['orgBySlug', convexApi.organizations.getBySlug, {slug:'nutriplan-digital'}]]) { try { const out=await client.query(fn,args); const summary=Array.isArray(out)?{length:out.length, first:out[0]&&{slug:out[0].slug, role:out[0].role?.name, active:out[0].active}}:out&&typeof out==='object'?{keys:Object.keys(out), slug:out.slug, email:out.email, isSuperAdmin:out.isSuperAdmin, active:out.active}:out; console.log(JSON.stringify({name, summary}, null, 2)); } catch(e) { console.log(JSON.stringify({name,error:e.message}, null, 2)); } } await apiReq.dispose();\""], decision="allow")
prefix_rule(pattern=["pnpm", "playwright:auth:preview"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "node --input-type=module -e \"import fs from 'node:fs'; import { request } from 'playwright'; import { ConvexHttpClient } from 'convex/browser'; import { api as convexApi } from './packages/convex/src/_generated/api.js'; const env={}; for(const f of ['.env.playwright.preview','.env.playwright.local']) if(fs.existsSync(f)) for(const l of fs.readFileSync(f,'utf8').split(/\\n/)){ const s=l.trim(); if(!s||s.startsWith('#')) continue; const i=s.indexOf('='); if(i>0 && !(s.slice(0,i) in env)) env[s.slice(0,i).trim()]=s.slice(i+1).trim().replace(/^['\\\"]|['\\\"]$/g,''); } const b64json=s=>JSON.parse(Buffer.from(s.replace(/-/g,'+').replace(/_/g,'/'),'base64url').toString('utf8')); const origin='https://develop-nutriplan-admin-dashboard.a-ortizcrr.workers.dev'; const apiReq=await request.newContext(); const res=await apiReq.post(origin+'/api/auth/sign-in/email',{headers:{'content-type':'application/json',accept:'application/json',origin,referer:origin+'/auth/sign-in'},data:{email:env.PW_SUPERADMIN_EMAIL,password:env.PW_SUPERADMIN_PASSWORD||env.PW_ADMIN_PASSWORD},timeout:30000,failOnStatusCode:false}); const cookies=res.headersArray().filter(h=>h.name.toLowerCase()==='set-cookie').map(h=>h.value.split(';')[0]); const jwt=cookies.find(c=>c.startsWith('__Secure-better-auth.convex_jwt='))?.split('=').slice(1).join('='); if(!jwt) { console.log(JSON.stringify({status:res.status(), body:(await res.text()).slice(0,300)})); process.exit(0); } const payload=b64json(jwt.split('.')[1]); const issuer=payload.iss || ''; const convexUrl=issuer.replace('.convex.site','.convex.cloud'); const client=new ConvexHttpClient(convexUrl); client.setAuth(jwt); const profile=await client.query(convexApi.userAuth.getCurrentUserProfile,{}); const isSuper=await client.query(convexApi.userAuth.isSuperAdminQuery,{}); console.log(JSON.stringify({status:res.status(), convexHost:new URL(convexUrl).host, email:profile?.email, profileFlag:profile?.isSuperAdmin, isSuperAdminQuery:isSuper},null,2)); await apiReq.dispose();\""], decision="allow")
prefix_rule(pattern=["pnpm", "--filter", "@nutriplan/dashboard", "exec", "vite", "dev"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "node -e \"const fs=require('fs'); const { request }=require('playwright'); const env={}; for(const f of ['.env.playwright.local','apps/dashboard/.env.local']) if(fs.existsSync(f)) for(const l of fs.readFileSync(f,'utf8').split(/\\n/)){ const s=l.trim(); if(!s||s.startsWith('#')) continue; const i=s.indexOf('='); if(i>0 && !(s.slice(0,i) in env)) env[s.slice(0,i).trim()]=s.slice(i+1).trim().replace(/^['\\\"]|['\\\"]$/g,''); } (async()=>{ const origin='http://127.0.0.1:3011'; const email=env.PW_ADMIN_EMAIL||env.TEST_ADMIN_EMAIL; const password=env.PW_ADMIN_PASSWORD||env.TEST_ADMIN_PASSWORD; const api=await request.newContext(); const res=await api.post(origin+'/api/auth/sign-in/email',{headers:{'content-type':'application/json',accept:'application/json',origin,referer:origin+'/auth/sign-in'},data:{email,password},timeout:30000,failOnStatusCode:false}); const body=await res.text(); const setCookies=res.headersArray().filter(h=>h.name.toLowerCase()==='set-cookie').map(h=>h.value.split(';')[0].split('=')[0]); console.log(JSON.stringify({status:res.status(), ok:res.ok(), setCookies, bodyPreview:body.slice(0,500)},null,2)); await api.dispose(); })().catch(e=>{console.error(e); process.exit(1)})\""], decision="allow")
