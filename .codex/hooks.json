{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|exec|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \".agents/skills/global-agent-guardrails/scripts/command-guard.mjs\" ] || AOHYS_GLOBAL_AGENT_GUARDRAILS=1 node \".agents/skills/global-agent-guardrails/scripts/command-guard.mjs\" hook --harness codex || exit 2",
            "timeout": 5,
            "statusMessage": "Checking destructive-command policy",
            "commandWindows": "if exist \".agents/skills/global-agent-guardrails/scripts/command-guard.mjs\" (set AOHYS_GLOBAL_AGENT_GUARDRAILS=1 & node \".agents/skills/global-agent-guardrails/scripts/command-guard.mjs\" hook --harness codex & exit /b)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \".agents/skills/impeccable/scripts/impeccable\" ] || \".agents/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 5,
            "statusMessage": "Checking UI changes",
            "commandWindows": "if exist \".agents/skills/impeccable/scripts/impeccable.cmd\" (\".agents/skills/impeccable/scripts/impeccable.cmd\" hook & exit /b)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \".agents/skills/impeccable/scripts/impeccable\" ] || \".agents/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 30,
            "statusMessage": "Design deep pass",
            "commandWindows": "if exist \".agents/skills/impeccable/scripts/impeccable.cmd\" (\".agents/skills/impeccable/scripts/impeccable.cmd\" hook & exit /b)"
          }
        ]
      }
    ]
  }
}
