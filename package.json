{
  "name": "aohys.com",
  "version": "0.0.0",
  "private": true,
  "description": "Public source site and private operations workspace for AOHYS.",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "architecture:fitness": "node scripts/architecture/run-fitness.mjs",
    "build": "pnpm -r --if-present build",
    "cloudflare:local": "pnpm --filter @aohys/site build && pnpm exec wrangler pages dev apps/site/dist --compatibility-date=2026-06-29",
    "release": "tsx scripts/release.ts",
    "doctor": "react-doctor",
    "quality:scorecard": "node scripts/quality/run-quality-scorecard.mjs",
    "quality:impeccable": ".agents/skills/impeccable/scripts/impeccable detect --quiet --no-advisory apps/dashboard/src apps/site/src",
    "build:resume-pdf": "python3 apps/site/scripts/build-resume-pdf.py",
    "ensure:cloudflare-production-domain": "tsx scripts/ensure-cloudflare-pages-domain.ts",
    "audit:cloudflare-pages-runtime": "tsx scripts/audit-cloudflare-pages-runtime.ts",
    "sync:cloudflare-pages-runtime:preview": "tsx scripts/sync-cloudflare-pages-runtime.ts preview",
    "sync:cloudflare-pages-runtime:production": "tsx scripts/sync-cloudflare-pages-runtime.ts production",
    "audit:posthog-env": "tsx scripts/audit-posthog-env-separation.ts",
    "observability:validate": "node scripts/observability/validate-signal-catalog.mjs && node scripts/observability/validate-alert-catalog.mjs",
    "observability:alert-drill": "node scripts/observability/run-alert-drill.mjs",
    "lint": "oxlint . && pnpm -r --if-present lint && pnpm run check:no-tests && node scripts/quality/check-lint-globs.mjs && pnpm run env:check",
    "performance:measure": "pnpm --filter @aohys/site build && node scripts/performance/measure.mjs",
    "performance:check": "node --check scripts/performance/browser-harness.js",
    "observability:audit:deploy": "node scripts/observability/audit-environment.mjs",
    "observability:check": "pnpm run observability:validate",
    "quality:commit": "pnpm run verify:foundation && pnpm run react:doctor:staged",
    "quality:changed": "node scripts/quality/run-changed-validation.mjs && node scripts/run-react-doctor-changed.mjs && pnpm run verify:product",
    "quality:certify": "pnpm run verify:ci && pnpm run react:doctor:changed && pnpm run verify:product",
    "quality:provider-readiness": "pnpm run release:env:preview && pnpm run audit:posthog-env && pnpm run audit:cloudflare-pages-runtime",
    "quality:push": "node scripts/quality/run-changed-validation.mjs && node scripts/run-react-doctor-changed.mjs",
    "prepare": "husky",
    "publish:content:build": "tsx scripts/apply-dashboard-published-content.ts",
    "release:env:preview": "tsx scripts/validate-release-env.ts preview",
    "release:env:production": "tsx scripts/validate-release-env.ts production",
    "seed:dashboard:preview": "tsx scripts/seed-dashboard-preview.ts",
    "sync:convex-env:preview": "tsx scripts/sync-convex-env.ts preview",
    "sync:convex-env:production": "tsx scripts/sync-convex-env.ts production",
    "smoke:preview": "tsx scripts/smoke-release-url.ts preview",
    "smoke:production": "tsx scripts/smoke-release-url.ts production",
    "strict:boundaries": "node scripts/quality/strict-boundaries.mjs",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p scripts/tsconfig.json",
    "verify:changed": "node scripts/quality/run-changed-validation.mjs",
    "verify:ci": "pnpm run verify:foundation && pnpm run lint && pnpm run typecheck && pnpm run architecture:fitness && pnpm run observability:check && pnpm run build && pnpm run quality:impeccable",
    "verify:foundation": "node scripts/verify-foundation.mjs",
    "verify:product": "node scripts/quality/check-product-verification.mjs",
    "verify:product:changed": "node scripts/quality/product-verification-changed.mjs",
    "verify:product:doctor": "node scripts/quality/product-verification-doctor.mjs",
    "verify:product:plan": "node scripts/quality/product-verification-plan.mjs",
    "verify:precommit": "pnpm exec lint-staged && pnpm run quality:commit",
    "react:doctor:staged": "node scripts/run-react-doctor-staged.mjs",
    "react:doctor:changed": "node scripts/run-react-doctor-changed.mjs",
    "verify:published-content": "pnpm run build:resume-pdf && pnpm --filter @aohys/content-graph typecheck && pnpm --filter @aohys/site typecheck && pnpm --filter @aohys/site build",
    "check:no-tests": "node scripts/quality/check-no-tests.mjs",
    "env:generate": "tsx scripts/generate-environment-artifacts.ts",
    "env:check": "tsx scripts/generate-environment-artifacts.ts --check"
  },
  "devDependencies": {
    "@aohys/backend": "workspace:*",
    "@aohys/core": "workspace:*",
    "@aohys/development-system": "https://github.com/AO-HyS/development-system/releases/download/v1.40.0/aohys-development-system-1.40.0.tgz",
    "@aohys/environment": "workspace:*",
    "@aohys/release-train": "workspace:*",
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@types/node": "^26.0.1",
    "convex": "^1.43.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.2",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.8.1",
    "react-doctor": "0.9.12",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.105.0"
  }
}
