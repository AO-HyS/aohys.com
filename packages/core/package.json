{
  "name": "@aohys/core",
  "version": "0.0.0",
  "private": true,
  "description": "Shared primitives for AOHYS packages and apps.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./domain": {
      "types": "./src/domain.ts",
      "import": "./src/domain.ts",
      "default": "./src/domain.ts"
    },
    "./unknown-guards": {
      "types": "./src/unknown-guards.ts",
      "import": "./src/unknown-guards.ts",
      "default": "./src/unknown-guards.ts"
    },
    "./release-targets": {
      "types": "./src/release-targets.ts",
      "import": "./src/release-targets.ts",
      "default": "./src/release-targets.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^6.0.3"
  }
}
